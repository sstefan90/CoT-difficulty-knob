# Copy to .env and fill in for your environment.
# .env is gitignored; .env.example is committed as the template.
# To load automatically: pip install python-dotenv and add
#   from dotenv import load_dotenv; load_dotenv()
# at the top of any script that needs these vars.
# Alternatively, export them in your shell profile (~/.bashrc / ~/.zshrc).

# --- Anthropic API (required for AvalonSummarizer — claude-sonnet-4-6 calls) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- LLM backend selection ---
# One of: ollama, sglang, mock
LLM_BACKEND=ollama

# --- Ollama (Mac dev) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# --- SGLang (RTX 5090 box, used later) ---
# SGLANG_URL=http://localhost:30000
# SGLANG_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# --- Ludii / Java ---
# Path to the Ludii JAR. download_ludii.sh will populate third_party/Ludii.jar.
LUDII_JAR=./third_party/Ludii.jar
# JAVA_HOME is required for JPype on macOS. With Homebrew openjdk@17:
#   brew install openjdk@17
#   export JAVA_HOME="$(brew --prefix openjdk@17)/libexec/openjdk.jdk/Contents/Home"
# JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home

# --- Tracking ---
RESULTS_DB=./data/results.db
RUNS_DIR=./data/runs
